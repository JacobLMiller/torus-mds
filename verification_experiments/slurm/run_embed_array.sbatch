#!/bin/bash
#SBATCH --job-name=torus-embed
#SBATCH --partition=compute
#SBATCH --cpus-per-task=2
#SBATCH --time=03:30:00
#SBATCH --mem=4G
#SBATCH --array=0-9
#SBATCH --output=slurm_logs/embed_%x_%A_%a.out
#SBATCH --error=slurm_logs/embed_%x_%A_%a.err
#
# --time=00:30:00 above is a placeholder, NOT a real budget -- you MUST
# override it per submission (see README.md for measured per-tier values,
# ranging ~20min to ~3hr). Embedding phase: one array task = one shard of
# one graph family.
#


set -euo pipefail

source "${MINIFORGE_ROOT:-$HOME/nobackup/miniforge3}/etc/profile.d/conda.sh"
conda activate torus-mds

FAMILY="${FAMILY:?Set FAMILY=sbm|grg|suitesparse via --export}"
SHARD="${SLURM_ARRAY_TASK_ID}"
LAYOUTS_ROOT="${LAYOUTS_ROOT:-layouts}"
TORUS_MAX_ITERS="${TORUS_MAX_ITERS:-10000}"
WRAP_PYTHON_MAX_N="${WRAP_PYTHON_MAX_N:-3500}"
SEED_BASE="${SEED_BASE:-0}"
STRESS_MODE="${STRESS_MODE:-normalized}"
METHODS="${METHODS:-TorusMDS_smart_1x_scale2 TorusMDS_random_1x_scale2 TorusMDS_spectral_init s_gd2 wrap_python}"

# Runs that deviate from the (raw, 10000-iter) default land in a
# distinctly-named subdir under LAYOUTS_ROOT (default "layouts") so they
# don't collide with -- or get skipped as already-done against -- manifests
# from a different configuration on the same graphs (e.g. a normalized-stress
# or iteration-count ablation sharing the same FAMILY/N_MIN/N_MAX). Override
# LAYOUTS_ROOT via --export if you want this run's output kept separate from
# an existing layouts/ tree entirely, rather than relying on that suffix.
FAMILY_SUBDIR="$FAMILY"
if [ "$STRESS_MODE" != "raw" ]; then
  FAMILY_SUBDIR="${FAMILY_SUBDIR}_${STRESS_MODE}"
fi
if [ "$TORUS_MAX_ITERS" != "10000" ]; then
  FAMILY_SUBDIR="${FAMILY_SUBDIR}_iters${TORUS_MAX_ITERS}"
fi
# suitesparse's N_MIN/N_MAX (unlike sbm/grg's) filter the staged manifest
# rather than selecting a pre-partitioned generation tier, which reassigns
# exp_idx over the filtered pool. Reusing the plain shard_<i>/ dirs under
# that filtering would silently desync graph_<exp_idx>.npz / runs.csv from
# the new mapping (stale graph file kept since it already exists, and a
# manifest row for a since-remapped exp_idx wrongly read as "already done"
# for the new graph at that index) -- so fold them into FAMILY_SUBDIR here,
# same as the STRESS_MODE/TORUS_MAX_ITERS suffixes above.
if [ "$FAMILY" = "suitesparse" ] && { [ -n "${N_MIN:-}" ] || [ -n "${N_MAX:-}" ]; }; then
  FAMILY_SUBDIR="${FAMILY_SUBDIR}_n${N_MIN:-0}to${N_MAX:-max}"
fi

case "$FAMILY" in
  sbm)
    N_MIN="${N_MIN:?Set N_MIN via --export}"
    N_MAX="${N_MAX:?Set N_MAX via --export}"
    if [ -n "${CACHE_DIR:-}" ]; then
      # Read a fixed pool pregenerated by stage_sbm.py -- see slurm/README.md.
      NUM_SHARDS="${NUM_SHARDS:?Set NUM_SHARDS via --export (must match --array size) when CACHE_DIR is set}"
      python verification_experiments/sbm_comparison.py \
        --cache-dir "$CACHE_DIR" \
        --shard-index "$SHARD" --num-shards "$NUM_SHARDS" \
        --torus-max-iters "$TORUS_MAX_ITERS" \
        --stress-mode "$STRESS_MODE" \
        --wrap-python-max-n "$WRAP_PYTHON_MAX_N" \
        --methods $METHODS \
        --output-dir "${LAYOUTS_ROOT}/${FAMILY_SUBDIR}/${N_MIN}_${N_MAX}/shard_${SHARD}"
    else
      GRAPHS_PER_SHARD="${GRAPHS_PER_SHARD:?Set GRAPHS_PER_SHARD via --export}"
      python verification_experiments/sbm_comparison.py \
        --n-graphs "$GRAPHS_PER_SHARD" \
        --n-min "$N_MIN" --n-max "$N_MAX" \
        --torus-max-iters "$TORUS_MAX_ITERS" \
        --stress-mode "$STRESS_MODE" \
        --wrap-python-max-n "$WRAP_PYTHON_MAX_N" \
        --methods $METHODS \
        --output-dir "${LAYOUTS_ROOT}/${FAMILY_SUBDIR}/${N_MIN}_${N_MAX}/shard_${SHARD}" \
        --seed "$((SEED_BASE + SHARD))"
    fi
    ;;
  grg)
    N_MIN="${N_MIN:?Set N_MIN via --export}"
    N_MAX="${N_MAX:?Set N_MAX via --export}"
    if [ -n "${CACHE_DIR:-}" ]; then
      # Read a fixed pool pregenerated by stage_grg.py -- see slurm/README.md.
      NUM_SHARDS="${NUM_SHARDS:?Set NUM_SHARDS via --export (must match --array size) when CACHE_DIR is set}"
      python verification_experiments/grg_comparison.py \
        --cache-dir "$CACHE_DIR" \
        --shard-index "$SHARD" --num-shards "$NUM_SHARDS" \
        --torus-max-iters "$TORUS_MAX_ITERS" \
        --stress-mode "$STRESS_MODE" \
        --wrap-python-max-n "$WRAP_PYTHON_MAX_N" \
        --methods $METHODS \
        --output-dir "${LAYOUTS_ROOT}/${FAMILY_SUBDIR}/${N_MIN}_${N_MAX}/shard_${SHARD}"
    else
      GRAPHS_PER_SHARD="${GRAPHS_PER_SHARD:?Set GRAPHS_PER_SHARD via --export}"
      GRAPH_TYPE_WEIGHTS="${GRAPH_TYPE_WEIGHTS:-1,1}"
      python verification_experiments/grg_comparison.py \
        --n-graphs "$GRAPHS_PER_SHARD" \
        --n-min "$N_MIN" --n-max "$N_MAX" \
        --graph-type-weights "$GRAPH_TYPE_WEIGHTS" \
        --torus-max-iters "$TORUS_MAX_ITERS" \
        --stress-mode "$STRESS_MODE" \
        --wrap-python-max-n "$WRAP_PYTHON_MAX_N" \
        --methods $METHODS \
        --output-dir "${LAYOUTS_ROOT}/${FAMILY_SUBDIR}/${N_MIN}_${N_MAX}/shard_${SHARD}" \
        --seed "$((SEED_BASE + SHARD))"
    fi
    ;;
  suitesparse)
    NUM_SHARDS="${NUM_SHARDS:?Set NUM_SHARDS via --export (must match --array size)}"
    # N_MIN/N_MAX are optional here (unlike sbm/grg, where they pick a
    # generation tier) -- they filter the already-staged manifest by its 'n'
    # column. Filtering changes which matrix each exp_idx maps to, so pass a
    # fresh --output-dir (LAYOUTS_ROOT and/or FAMILY_SUBDIR) whenever these
    # are set, rather than reusing a directory built without them.
    N_MIN_ARGS=()
    [ -n "${N_MIN:-}" ] && N_MIN_ARGS+=(--n-min "$N_MIN")
    [ -n "${N_MAX:-}" ] && N_MIN_ARGS+=(--n-max "$N_MAX")
    python verification_experiments/suitesparse_comparison.py \
      --cache-dir "${SUITESPARSE_CACHE_DIR:-data/suitesparse_cache}" \
      --shard-index "$SHARD" --num-shards "$NUM_SHARDS" \
      "${N_MIN_ARGS[@]}" \
      --torus-max-iters "$TORUS_MAX_ITERS" \
      --wrap-python-max-n "$WRAP_PYTHON_MAX_N" \
      --stress-mode "$STRESS_MODE" \
      --methods $METHODS \
      --output-dir "${LAYOUTS_ROOT}/${FAMILY_SUBDIR}/shard_${SHARD}"
    ;;
  *)
    echo "Unknown FAMILY=$FAMILY (expected sbm|grg|suitesparse)" >&2
    exit 1
    ;;
esac
